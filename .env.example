# Local-only secrets. Paste keys in .env, never commit it or share it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
URLHAUS_AUTH_KEY=
VT_API_KEY=
# Optional authorized fallback credentials; shared quotas still apply.
VT_API_KEY_2=
VT_API_KEY_3=

# Optional remote dynamic analysis (APK upload requires separate explicit consent)
APKTRUST_DYNAMIC_ENABLED=false
APKTRUST_FTL_PROJECT_ID=
APKTRUST_FTL_DEVICE_MODEL=
APKTRUST_FTL_ANDROID_VERSION=
APKTRUST_FTL_TIMEOUT_SECONDS=300
APKTRUST_FTL_JOB_TIMEOUT_SECONDS=900
